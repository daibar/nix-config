{ config, pkgs, lib, unstable, ... }:
let
  # Link straight to the repo (not the nix store) so lazy.nvim can write
  # lazy-lock.json and init.lua edits apply without a switch.
  nvimDir = "${config.home.homeDirectory}/nix-config/home-manager/nvim";
  link = config.lib.file.mkOutOfStoreSymlink;

  # nvim-lspconfig server name -> packages it needs. init.lua enables every
  # server listed here; per-server settings stay in init.lua.
  lspServers = with unstable; {
    gopls = [ gopls ];
    lua_ls = [ lua-language-server ];
    golangci_lint_ls = [ golangci-lint-langserver golangci-lint ];
  };
  lspPath = lib.makeBinPath (lib.flatten (lib.attrValues lspServers));
  luaList = xs: "{ " + lib.concatMapStringsSep ", " (x: ''"${x}"'') xs + " }";
in {
  xdg.configFile = {
    "nvim/init.lua".source = link "${nvimDir}/init.lua";
    "nvim/lazy-lock.json".source = link "${nvimDir}/lazy-lock.json";

    # Values from nix (store paths, server lists) for init.lua to read
    "nvim/lua/nix_env.lua".text = ''
      -- Generated by home-manager (nvim.nix). Do not edit.
      return {
        lsp_servers = ${luaList (lib.attrNames lspServers)},
        lsp_path = "${lspPath}",
      }
    '';
  };
}
